# Optional configuration for DataObserve deployment
# Copy this file to .env before running: docker compose up -d

# Port mappings (optional, default: 80 for frontend, 8001 for backend)
# FRONTEND_PORT=80
# BACKEND_PORT=8001

# Optional API keys for additional backend features
# CLAWHUB_API_TOKEN=your_clawhub_token_here
# AMAP_API_KEY=your_amap_api_key_here
